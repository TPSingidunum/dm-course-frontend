{
  "name": "dm-course-frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev --no-fork",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "lint": "bun --bun eslint .",
    "postinstall": "bun --bun nuxt prepare",
    "typecheck": "bun --bun vue-tsc --noEmit -p .nuxt/tsconfig.app.json && bun --bun vue-tsc --noEmit -p .nuxt/tsconfig.server.json"
  },
  "dependencies": {
    "@nuxt/eslint": "1.10.0",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "4.1.0",
    "@types/node": "^24.19.2",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.5",
    "mysql2": "^3.24.6",
    "nuxt": "^4.6.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
